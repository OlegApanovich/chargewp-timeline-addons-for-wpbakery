# to use check (inside docker container)
# ../vendor/bin/phpstan analyse
parameters:
    level: 5 # Adjust the strictness level (0 to 9).
    phpVersion: 70100
    bootstrapFiles:
        - ../../../../wp-load.php # Load WordPress core files for analysis.
    ignoreErrors:
        -
            # WPB_VC_VERSION is defined as a fixed literal in the WPBakery version
            # installed in this environment, so PHPStan statically folds the
            # version_compare() check below. At runtime the installed WPBakery
            # version varies, so the older-version branch is not actually dead code.
            identifier: if.alwaysTrue
            path: ../src/ElementIntegration/IconIntegration.php
        -
            identifier: deadCode.unreachable
            path: ../src/ElementIntegration/IconIntegration.php
    paths:
        - ../includes
        - ../src
        - ../config
        - ../templates
    excludePaths:
        - ../includes/wpbakery-custom-param-collection/*
    scanFiles:
        - ../vendor/php-stubs/wordpress-stubs/wordpress-stubs.php